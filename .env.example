# OpenAI API Key (Required for live voice WebRTC Realtime API)
# If left blank, the application operates in text & simulated speech demo mode.
OPENAI_API_KEY=

# Server Port
PORT=3001

# Client Port (for dev proxy reference)
VITE_PORT=5173

# Optional: Default Realtime voice (e.g., alloy, verse, shimmer, ash, coral)
OPENAI_REALTIME_VOICE=alloy

# Vapi Voice Configuration (Get your Public Key from https://dashboard.vapi.ai/keys)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
